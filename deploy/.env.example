# Copy to deploy/.env and edit it before running Compose.
# The data directory must already contain the separately supplied runtime data.
# Linux: /srv/newapp-data; Windows Docker Desktop: D:/jbrowsedata/projectdata
DATA_DIR=/srv/newapp-data
HTTP_PORT=8080

POSTGRES_DB=grcg6a
POSTGRES_USER=grcuser
# Required: choose a long, unique password using letters/digits (URI-safe).
# This file intentionally provides no password.
POSTGRES_PASSWORD=

# Browser URL used to reach the frontend; adjust it for your domain.
ALLOWED_ORIGINS=http://localhost:8080
GRCG6A_GENE_FAMILY_RELEASE_ID=gg-gf-2026-07-rc1

# Frontend variables are embedded during the image build.
# Empty API base uses the included same-origin Nginx proxy.
VITE_API_BASE=
# Set the externally deployed BLAST web service's browser-accessible URL.
# /blast-service requires a separately configured reverse proxy at that path.
VITE_BLAST_BASE=/blast-service
