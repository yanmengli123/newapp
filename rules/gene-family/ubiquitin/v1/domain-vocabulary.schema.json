{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chickendata.local/schemas/gene-family/domain-vocabulary-v1.json",
  "title": "Gene-family controlled domain vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["vocabulary_id", "version", "status", "terms"],
  "properties": {
    "vocabulary_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "approved", "deprecated"]},
    "curator": {"type": ["string", "null"]},
    "approved_by": {"type": ["string", "null"]},
    "approval_date": {"type": ["string", "null"], "format": "date"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term_id", "label", "definition", "mappings", "status"],
        "properties": {
          "term_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*:[A-Za-z0-9._-]+$"},
          "label": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "deprecated"]},
          "replaced_by": {"type": ["string", "null"]},
          "synonyms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["database", "accession"],
              "properties": {
                "database": {"type": "string", "minLength": 1},
                "accession": {"type": "string", "minLength": 1},
                "accession_version": {"type": ["string", "null"]},
                "model_release": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}

