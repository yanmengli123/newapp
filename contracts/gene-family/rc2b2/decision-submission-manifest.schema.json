{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chickendata.local/contracts/gene-family/rc2b2/decision-submission-manifest.schema.json",
  "title": "RC2-B.2 append-only decision submission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "submission_version",
    "scheme_id",
    "parent_batch_id",
    "parent_batch_manifest_sha256",
    "contract_version",
    "contract_manifest_sha256",
    "evaluator_tag",
    "evaluator_commit",
    "artifacts",
    "created_by",
    "created_at",
    "status",
    "supersedes_submission_id",
    "scientific_decision_count",
    "scientific_approval_implied",
    "pilot_scan_authorized",
    "full_targeted_scan_authorized",
    "formal_shadow_authorized",
    "rc2c_build_authorized",
    "api_frontend_switch_authorized",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "submission_id": {
      "type": "string",
      "pattern": "^gg-gf-[a-z0-9-]+-curation-rc2b2-submission-v[0-9]{3}$"
    },
    "submission_version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "scheme_id": {"const": "ubiquitin_core"},
    "parent_batch_id": {
      "type": "string",
      "pattern": "^gg-gf-[a-z0-9-]+-curation-rc2-batch-[0-9]{3}$"
    },
    "parent_batch_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "contract_version": {"const": "gg-gf-rc2b2-readiness-1.0"},
    "contract_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_tag": {"const": "gene-family-rc2b-evaluator-core-v1.0"},
    "evaluator_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"const": "engineering_preparer"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": ["engineering_prepared_unapproved", "curator_submitted", "superseded"]
    },
    "supersedes_submission_id": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^gg-gf-[a-z0-9-]+-curation-rc2b2-submission-v[0-9]{3}$"
        }
      ]
    },
    "scientific_decision_count": {"type": "integer", "minimum": 0},
    "scientific_approval_implied": {"const": false},
    "pilot_scan_authorized": {"const": false},
    "full_targeted_scan_authorized": {"const": false},
    "formal_shadow_authorized": {"const": false},
    "rc2c_build_authorized": {"const": false},
    "api_frontend_switch_authorized": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "relative_path", "status", "sha256"],
      "properties": {
        "artifact_type": {
          "enum": [
            "parent_batch_lock",
            "target_universe_manifest",
            "target_gene_universe",
            "target_transcript_universe",
            "target_protein_universe",
            "scan_execution_universe",
            "scan_subject_map",
            "target_scan_fasta",
            "noncoding_transcript_exclusions",
            "multi_placement_evidence",
            "annotation_exception_evidence",
            "shared_sequence_evidence",
            "bap1_placement_evidence",
            "loc100859273_source_disposition",
            "scan_command_manifest",
            "scan_environment_manifest",
            "evidence_admissibility",
            "domain_vocabulary",
            "mapping_decisions",
            "rollup_policy",
            "publication_policy",
            "rule_bundle",
            "regression_fixture_bundle",
            "approval_attestation_bundle"
          ]
        },
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "status": {
          "enum": ["observed_engineering_evidence", "expected_curator_artifact"]
        },
        "sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "observed_engineering_evidence"}}},
          "then": {"properties": {"sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {"properties": {"status": {"const": "expected_curator_artifact"}}},
          "then": {"properties": {"sha256": {"type": "null"}}}
        }
      ]
    }
  }
}
