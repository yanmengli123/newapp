{
  "contract_id": "gf-shadow-runner-io-v1",
  "version": "1.0.0",
  "status": "interface_frozen_implementation_absent",
  "orchestration_only": true,
  "adds_rule_operators": false,
  "formal_assertion_write_allowed": false,
  "release_database_write_allowed": false,
  "required_inputs": ["shadow-input-manifest.json", "inputs-lock.json", "subject-universe.tsv", "scan-run-manifest.json", "evidence-admissibility-policy.json", "domain-vocabulary.json", "rule-bundle.json", "mapping-decisions.tsv", "rollup-policy.json", "publication-policy.json", "fixture-bundle.json", "scientific-approval-aggregate.json", "shadow-run-authorization.json"],
  "ordered_process": ["input_validation", "subject_universe_validation", "evidence_adaptation", "rule_evaluation", "node_trace", "protein_outcomes", "gene_rollup", "publication_proposals", "metrics", "rc1_diff", "gates", "provenance"],
  "required_outputs": ["shadow-manifest.json", "inputs-lock.json", "subject-universe.tsv", "rule-evaluations.tsv", "rule-node-traces.tsv", "trace-evidence-links.tsv", "protein-outcomes.tsv", "gene-rollup-proposals.tsv", "publication-proposals.tsv", "metrics.json", "diff-vs-rc1.json", "gate-results.json", "rejected-records.tsv", "limitations.json", "provenance.jsonld", "checksums.sha256"],
