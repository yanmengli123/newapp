  "provenance_profiles": {"prov_o": "https://www.w3.org/TR/prov-o/", "ro_crate": "https://w3id.org/ro/crate/1.3", "ro_crate_1_3_status_wording": "current long-term specification release; not described as a W3C Recommendation"}
