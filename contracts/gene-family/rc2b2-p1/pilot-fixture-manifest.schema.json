{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chickendata.example/contracts/gene-family/rc2b2-p1/pilot-fixture-manifest.schema.json",
  "title": "RC2-B.2-P1 Pilot fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_set_id",
    "package_id",
    "state",
    "created_at_utc",
    "p0_target_manifest_sha256",
    "source_artifacts",
    "counts",
    "fixtures",
    "artifacts",
    "scientific_classification_claimed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fixture_set_id": {"const": "gg-gf-pfam35-pilot-fixtures-v1"},
    "package_id": {"const": "rc2b2-p1-pilot-fixtures-v001"},
    "state": {"const": "frozen"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "p0_target_manifest_sha256": {
      "const": "1f74a288c9fcbf3d552fcd01145bb430b615652797057eb8784ea245f636b3e6"
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_records", "unique_scan_executions", "scientific_subjects", "shared_execution_fixtures", "expected_no_hit_executions"],
      "properties": {
        "fixture_records": {"type": "integer", "minimum": 1},
        "unique_scan_executions": {"type": "integer", "minimum": 1},
        "scientific_subjects": {"type": "integer", "minimum": 1},
        "shared_execution_fixtures": {"type": "integer", "minimum": 1},
        "expected_no_hit_executions": {"type": "integer", "minimum": 1}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/fixture"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "scientific_classification_claimed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "logical_locator", "byte_size", "sha256"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "logical_locator": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcome": {
      "enum": ["reported_hits_expected", "no_reported_hits_expected"]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "scientific_subject_key",
        "scan_execution_key",
        "sequence_sha256",
        "expected_authoritative_scan_outcome",
        "expected_diagnostic_scan_outcome",
        "expected_pfam_accessions",
        "expected_sequence_ga_pass",
        "expected_domain_ga_pass",
        "expected_reexpansion_count",
        "expected_execution_status",
        "expected_subject_status",
        "must_not_report_accessions",
        "fixture_evidence_hash"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^P1F-[0-9]{3}$"},
        "scientific_subject_key": {"type": "string", "pattern": "^[A-Z]{2}_[0-9]+\\.[0-9]+$"},
        "scan_execution_key": {"$ref": "#/$defs/sha256"},
        "sequence_sha256": {"$ref": "#/$defs/sha256"},
        "expected_authoritative_scan_outcome": {"$ref": "#/$defs/outcome"},
        "expected_diagnostic_scan_outcome": {"$ref": "#/$defs/outcome"},
        "expected_pfam_accessions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PF[0-9]{5}\\.[0-9]+$"}
        },
        "expected_sequence_ga_pass": {"type": ["boolean", "null"]},
        "expected_domain_ga_pass": {"type": ["boolean", "null"]},
        "expected_reexpansion_count": {"type": "integer", "minimum": 1},
        "expected_execution_status": {"enum": ["completed_with_hits", "completed_no_hits"]},
        "expected_subject_status": {"enum": ["completed_with_hits", "completed_no_hits"]},
        "must_not_report_accessions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PF[0-9]{5}\\.[0-9]+$"}
        },
        "fixture_evidence_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
